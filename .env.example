# Copy to .env (never committed) or set in the deploy-time compose file.
# The Spokes servers the page may show, as Name=URL pairs separated by commas.
# The browser only ever sends a name; the URLs never leave the backend.
SPOKES_VIEW_SERVERS=Home=http://spokes.example.lan:8787,Dev=http://127.0.0.1:8787
# Listen address (the image defaults to 0.0.0.0:8788).
SPOKES_VIEW_BIND=127.0.0.1:8788
# error, warn, info, debug or trace
SPOKES_VIEW_LOG=info
